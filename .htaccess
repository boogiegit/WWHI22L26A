Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# Never expose recovery data, server configuration, tests or repository metadata.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:data|server|tests|private|imports|exports|backups|logs|tmp|node_modules|vendor|dist|build|operational-data|guest-data|guest-lists|passenger-data|rooming-lists)(?:/|$) - [F,L,NC]
RewriteRule \.(?:db|sqlite3?|sql|log|bak|backup|old|orig|zip|tar|gz|bz2|xz|zst|tgz|7z|rar|csv|tsv|xlsx?|ods|pem|key|p12|pfx)$ - [F,L,NC]
RewriteRule \.(?:db|sqlite3?)-(?:wal|shm|journal)$ - [F,L,NC]
RewriteRule \.local\.(?:php|json|js)$ - [F,L,NC]

# Existing document URLs continue to work, but PHP authorizes every request.
RewriteRule ^((?:seating-plans|venice-passes|uploads)/.*|(?:colosseum-tickets|pantheon-tickets)/(?!index\.html$).*|(?:moulin-rouge-)?menu-choices\.json|tour-data\.(?:json|js))$ api.php?action=privateFile&path=$1 [B,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "base-uri 'self'; frame-ancestors 'self'; form-action 'self'; object-src 'none'"
  <FilesMatch "\.(?:html|json|php)$">
    Header always set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
